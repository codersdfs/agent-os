{
  "name": "{{name}}",
  "version": "0.1.0",
  "description": "Agent OS workspace: skill-powered AI workflows + LLM Wiki template",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "skill-auto": "node scripts/skill_loader.js --auto",
    "skill-match": "node scripts/skill_loader.js --match",
    "skill-load": "node scripts/skill_loader.js --load",
    "skill-list": "node scripts/skill_loader.js --list",
    "skill-build": "node scripts/build_index.js",
    "skill-assemble": "node scripts/assemble_prompt.js",
    "selfcheck": "node scripts/selfcheck.js",
    "security-scan": "node scripts/security_scan.js",
    "verify": "node scripts/verify.js",
    "wiki-ingest": "node scripts/wiki_ingest.js",
    "wiki-query": "node scripts/wiki_query.js",
    "wiki-lint": "node scripts/wiki_lint.js",
    "wiki-ingest:stdin": "node scripts/wiki_ingest.js --stdin",
    "wiki-query:json": "node scripts/wiki_query.js --json",
    "wiki-lint:fix": "node scripts/wiki_lint.js --fix",
    "wiki-map": "node scripts/wiki_map.js",
    "wiki-map:api": "node scripts/wiki_map.js 3001"
  },
  "dependencies": {
    "js-yaml": "^4.3.1"
  },
  "engines": {
    "node": ">=18"
  }
}