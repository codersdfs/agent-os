#!/bin/sh
# Pre-commit hook for AI-Coding Framework
# Runs the Node vibe classifier at commit time.

echo "Running AI-Coding Framework checks..."

# Find changed Python files
CHANGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$')

if [ -z "$CHANGED_FILES" ]; then
    echo "No Python files changed — skipping checks"
    exit 0
fi

FAILED=0
for FILE in $CHANGED_FILES; do
    echo "Checking $FILE..."

    # Auto-detect risk level and run checks
    RISK_LEVEL=$(node bin/vibe.js classify "$FILE" 2>/dev/null | grep -oE '(HIGH|MEDIUM|LOW)' | tr '[:lower:]' '[:upper:]')

    if [ -n "$RISK_LEVEL" ]; then
        node bin/vibe.js check "$FILE" --risk-level "$RISK_LEVEL" || FAILED=1
    fi
done

if [ $FAILED -eq 1 ]; then
    echo ""
    echo "❌ AI-Coding Framework checks failed"
    echo "   High-risk code requires full review before commit."
    echo "   Use 'vibe signoff' to certify your changes."
    exit 1
fi

echo "✓ All checks passed"
