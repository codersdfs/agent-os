{
  "name": "meta-skill-framework",
  "version": "1.0.0",
  "description": "Self-referential meta-skill framework: a 7-defense architecture that teaches AI coding agents how to manage and use skills. Includes build tooling (indexer, compressor, assembler) and runtime skill activation via trigger keywords.",
  "keywords": [
    "meta-skill",
    "framework",
    "skill-management",
    "ai-agent",
    "coding-agent",
    "prompt-engineering",
    "knowledge-graph"
  ],
  "license": "MIT",
  "author": "codersdfs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codersdfs/skill.git"
  },
  "bugs": {
    "url": "https://github.com/codersdfs/skill/issues"
  },
  "homepage": "https://github.com/codersdfs/skill#readme",
  "bin": {
    "meta-skill-framework": "bin/meta-skill-framework.js",
    "planning": "bin/planning.js",
    "vibe": "bin/vibe.js"
  },
  "engines": {
    "node": ">=14.0.0",
    "python": ">=3.7"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/*.py",
    "skills/",
    "Makefile",
    "README.md"
  ],
  "scripts": {
    "build": "python scripts/build_index.py",
    "assemble": "python scripts/assemble_prompt.py",
    "list": "node bin/meta-skill-framework.js list",
    "match": "node bin/meta-skill-framework.js match",
    "auto": "node bin/meta-skill-framework.js auto",
    "load": "node bin/meta-skill-framework.js load",
    "prepublishOnly": "node bin/meta-skill-framework.js build",
    "vibe": "node bin/vibe.js",
    "vibe:classify": "node bin/vibe.js classify",
    "vibe:check": "node bin/vibe.js check",
    "vibe:audit": "node bin/vibe.js audit",
    "vibe:signoff": "node bin/vibe.js signoff"
  }
}
