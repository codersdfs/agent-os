{
  "name": "@franklinww/create-agent-os",
  "version": "2.2.0",
  "description": "BETA. Scaffold an agent OS workspace: skill-powered AI workflows + an LLM Wiki template in one repo. Includes vibe coding framework and meta-skill management. Pure Node — no python, no pip.",
  "bin": {
    "meta-skill-framework": "bin/meta-skill-framework.js",
    "planning": "bin/planning.js",
    "vibe": "bin/vibe.js",
    "create-agent-os": "index.js"
  },
  "files": ["index.js", "bin/", "src/"],
  "type": "commonjs",
  "engines": { "node": ">=18" },
  "license": "MIT",
  "author": "codersdfs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codersdfs/agent-os.git"
  },
  "keywords": ["agent", "skills", "llm", "workflow", "obsidian", "wiki", "second-brain", "claude", "pi", "codex", "vibe-coding"],
  "scripts": {
    "build": "node bin/meta-skill-framework.js build",
    "assemble": "node bin/meta-skill-framework.js assemble",
    "list": "node bin/meta-skill-framework.js list",
    "match": "node bin/meta-skill-framework.js match",
    "auto": "node bin/meta-skill-framework.js auto",
    "load": "node bin/meta-skill-framework.js load",
    "vibe": "node bin/vibe.js",
    "vibe:classify": "node bin/vibe.js classify",
    "vibe:check": "node bin/vibe.js check",
    "vibe:audit": "node bin/vibe.js audit",
    "vibe:signoff": "node bin/vibe.js signoff",
    "selfcheck": "node src/template/scripts/selfcheck.js",
    "verify": "node src/template/scripts/verify.js",
    "security-scan": "node src/template/scripts/security_scan.js",
    "wiki-ingest": "node src/template/scripts/wiki_ingest.js",
    "wiki-query": "node src/template/scripts/wiki_query.js",
    "wiki-lint": "node src/template/scripts/wiki_lint.js",
    "wiki-ingest:stdin": "node src/template/scripts/wiki_ingest.js --stdin",
    "wiki-query:json": "node src/template/scripts/wiki_query.js --json",
    "wiki-lint:fix": "node src/template/scripts/wiki_lint.js --fix",
    "wiki-map": "node src/template/scripts/wiki_map.js",
    "wiki-map:api": "node src/template/scripts/wiki_map.js 3001"
  },
  "dependencies": { "js-yaml": "^4.3.1" }
}
