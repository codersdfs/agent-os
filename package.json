{
  "name": "meta-skill-framework",
  "version": "2.1.0",
  "description": "Scaffold an agent OS workspace: skill-powered AI workflows + an LLM Wiki template in one repo. Includes vibe coding framework and meta-skill management.",
  "bin": {
    "meta-skill-framework": "bin/meta-skill-framework.js",
    "planning": "bin/planning.js",
    "vibe": "bin/vibe.js",
    "create-agent-os": "index.js"
  },
  "files": ["index.js", "bin/", "src/", "template", "scripts/*.py", "skills/"],
  "type": "commonjs",
  "engines": { "node": ">=18" },
  "license": "MIT",
  "author": "codersdfs",
  "repository": { "type": "git", "url": "git+https://github.com/codersdfs/agent-os.git" },
  "keywords": ["agent", "skills", "llm", "workflow", "obsidian", "wiki", "second-brain", "claude", "pi", "codex", "vibe-coding"],
  "scripts": {
    "build": "python scripts/build_index.py",
    "assemble": "python scripts/assemble_prompt.py",
    "list": "node bin/meta-skill-framework.js list",
    "match": "node bin/meta-skill-framework.js match",
    "auto": "node bin/meta-skill-framework.js auto",
    "load": "node bin/meta-skill-framework.js load",
    "vibe": "node bin/vibe.js",
    "vibe:classify": "node bin/vibe.js classify",
    "vibe:check": "node bin/vibe.js check",
    "vibe:audit": "node bin/vibe.js audit",
    "vibe:signoff": "node bin/vibe.js signoff",
    "selfcheck": "node template/scripts/selfcheck.js",
    "verify": "node template/scripts/verify.js",
    "security-scan": "node template/scripts/security_scan.js"
  },
  "dependencies": { "js-yaml": "^4.3.1" }
}
